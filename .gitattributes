# Normalize line endings by file type.
* text=auto
.gitattributes text eol=lf
.simplecov text eol=lf
release/VERSION text eol=lf

# POSIX entrypoints and test sources.
*.sh text eol=lf
*.bash text eol=lf
*.bats text eol=lf
multi-cli text eol=lf

# Windows-native scripts and modules.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Portable text formats.
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets.
*.icns binary
*.png binary
