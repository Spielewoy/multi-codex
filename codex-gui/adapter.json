{
  "schemaVersion": 2,
  "id": "codex-gui",
  "displayName": "Codex Desktop App",
  "kind": "gui",
  "binary": {
    "windows": [
      "appx:OpenAI.Codex!App"
    ],
    "macos": [
      "/Applications/Codex.app/Contents/MacOS/Codex",
      "Codex"
    ],
    "linux": [
      "codex-app-not-available"
    ]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "detached",
    "args": [],
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": [
      "Windows user credential namespace and %USERPROFILE%\\.codex"
    ],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.codex",
      "macos": "$HOME/.codex",
      "linux": "$HOME/.codex"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": []
  },
  "concurrency": {
    "level": "singleWriter",
    "singletonScope": "osUser"
  },
  "support": {
    "windows": {
      "level": "supported",
      "reason": "Microsoft Store product 9PLM9XGG6VKS; OS-user isolation requires an elevated terminal"
    },
    "macos": {
      "level": "unsupported",
      "reason": "Owned-user macOS GUI login and Keychain isolation are not yet proven by a real logged-in desktop session."
    },
    "linux": {
      "level": "unsupported",
      "reason": "no Codex desktop app on Linux"
    }
  },
  "install": "winget install --id 9PLM9XGG6VKS -s msstore",
  "versionCommand": []
}
