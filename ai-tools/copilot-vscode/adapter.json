{
  "schemaVersion": 2,
  "id": "copilot-vscode",
  "displayName": "GitHub Copilot in VS Code",
  "kind": "ide",
  "binary": {
    "windows": [
      "code.cmd",
      "code"
    ],
    "macos": [
      "code"
    ],
    "linux": [
      "code"
    ]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "detached",
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": [
      "VS Code GitHub authentication and Copilot extension credential store"
    ],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%APPDATA%\\Code",
      "macos": "$HOME/Library/Application Support/Code",
      "linux": "$HOME/.config/Code"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": [
      "User/globalStorage",
      "User/workspaceStorage"
    ]
  },
  "concurrency": {
    "level": "singleWriter",
    "singletonScope": "hostProfile"
  },
  "support": {
    "windows": {
      "level": "supported",
      "reason": "OS-user isolation; elevated terminal required (GitHub auth in OS store)"
    },
    "macos": {
      "level": "unsupported",
      "reason": "Owned-user macOS GUI login and Keychain isolation are not yet proven by a real logged-in desktop session."
    },
    "linux": {
      "level": "unsupported",
      "reason": "Owned-user Linux GUI and Secret Service sessions are not yet implemented and verified."
    }
  },
  "install": "https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-extension",
  "versionCommand": [
    "--version"
  ]
}
