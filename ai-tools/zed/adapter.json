{
  "schemaVersion": 2,
  "id": "zed",
  "displayName": "Zed",
  "kind": "ide",
  "binary": {
    "windows": [
      "zed.exe",
      "zed"
    ],
    "macos": [
      "/usr/local/bin/zed",
      "zed"
    ],
    "linux": [
      "zed",
      "zeditor"
    ]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "detached",
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": [
      "Zed credential store scoped to the owned OS user"
    ],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%LOCALAPPDATA%\\Zed",
      "macos": "$HOME/Library/Application Support/Zed",
      "linux": "$HOME/.local/share/zed"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": [
      "db"
    ]
  },
  "concurrency": {
    "level": "singleWriter",
    "singletonScope": "releaseChannelAndOsUser"
  },
  "support": {
    "windows": {
      "level": "supported",
      "reason": "OS-user isolation; elevated terminal required for concurrent same-channel windows"
    },
    "macos": {
      "level": "unsupported",
      "reason": "Owned-user macOS GUI login and Keychain isolation are not yet proven by a real logged-in desktop session."
    },
    "linux": {
      "level": "unsupported",
      "reason": "Owned-user Linux GUI and Secret Service sessions are not yet implemented and verified."
    }
  },
  "install": "https://zed.dev/docs/installation",
  "versionCommand": [
    "--version"
  ]
}
