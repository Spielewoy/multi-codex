{
  "schemaVersion": 2,
  "id": "agy-cli",
  "displayName": "Antigravity CLI (agy)",
  "kind": "cli",
  "binary": {
    "windows": [
      "%LOCALAPPDATA%\\agy\\bin\\agy.exe",
      "agy"
    ],
    "macos": [
      "$HOME/.local/bin/agy",
      "agy"
    ],
    "linux": [
      "$HOME/.local/bin/agy",
      "agy"
    ]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "foreground",
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": [
      "Fixed gemini/antigravity OS credential"
    ],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.gemini\\antigravity-cli",
      "macos": "$HOME/.gemini/antigravity-cli",
      "linux": "$HOME/.gemini/antigravity-cli"
    },
    "sharedPaths": [
      "settings.json",
      "plugins",
      "skills"
    ],
    "sessionPaths": [],
    "filePaths": [
      "settings.json"
    ],
    "unsafePaths": []
  },
  "concurrency": {
    "level": "multiWriter",
    "singletonScope": "osUser"
  },
  "support": {
    "windows": {
      "level": "supported",
      "reason": "OS-user isolation; elevated terminal required"
    },
    "macos": {
      "level": "unsupported",
      "reason": "Owned-user macOS login Keychain isolation is not yet proven by an authenticated run."
    },
    "linux": {
      "level": "unsupported",
      "reason": "Owned-user Linux Secret Service session isolation is not yet implemented and verified."
    }
  },
  "install": "https://antigravity.google/docs/cli/install",
  "versionCommand": [
    "--version"
  ]
}
