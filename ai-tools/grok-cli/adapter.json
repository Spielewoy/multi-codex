{
  "schemaVersion": 2,
  "id": "grok-cli",
  "displayName": "Grok Build CLI",
  "kind": "cli",
  "binary": { "windows": ["grok"], "macos": ["grok"], "linux": ["grok"] },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "foreground",
    "env": { "GROK_HOME": "{sharedStateRoot}" },
    "clearEnv": []
  },
  "account": {
    "mechanism": "processSecret",
    "credentialFiles": [],
    "credentialPrecedence": ["model.api_key", "model.env_key", "active session", "XAI_API_KEY"],
    "logoutScope": "process",
    "secret": { "environmentVariable": "XAI_API_KEY" }
  },
  "normalState": {
    "root": { "windows": "%USERPROFILE%\\.grok", "macos": "$HOME/.grok", "linux": "$HOME/.grok" },
    "sharedPaths": ["config.toml", "sandbox.toml", "crash"],
    "sessionPaths": [],
    "filePaths": ["config.toml", "sandbox.toml"],
    "unsafePaths": []
  },
  "concurrency": { "level": "multiWriter", "singletonScope": "none" },
  "support": {
    "windows": { "level": "supported", "reason": "process token via multi-cli auth set; shared config must not pin model.api_key" },
    "macos": { "level": "supported" },
    "linux": { "level": "supported" }
  },
  "install": "https://docs.x.ai/build/overview",
  "versionCommand": ["version"]
}
