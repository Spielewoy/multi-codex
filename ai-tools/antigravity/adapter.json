{
  "schemaVersion": 2,
  "id": "antigravity",
  "displayName": "Google Antigravity IDE",
  "kind": "ide",
  "binary": {
    "windows": [
      "%LOCALAPPDATA%\\Programs\\Antigravity\\Antigravity.exe",
      "antigravity"
    ],
    "macos": [
      "/Applications/Antigravity.app/Contents/MacOS/Antigravity",
      "$HOME/Applications/Antigravity.app/Contents/MacOS/Antigravity"
    ],
    "linux": [
      "/usr/bin/antigravity",
      "/opt/Antigravity/antigravity",
      "$HOME/.local/bin/antigravity"
    ]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "detached",
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": [
      "Windows gemini:antigravity",
      "macOS gemini/antigravity",
      "Linux service=gemini username=antigravity"
    ],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%APPDATA%\\Antigravity IDE",
      "macos": "$HOME/Library/Application Support/Antigravity IDE",
      "linux": "$HOME/.config/Antigravity IDE"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": [
      "User/globalStorage/storage.json",
      "User/globalStorage/state.vscdb"
    ]
  },
  "concurrency": {
    "level": "singleWriter",
    "singletonScope": "osUser"
  },
  "support": {
    "windows": {
      "level": "supported",
      "reason": "OS-user isolation; elevated terminal required (fixed gemini/antigravity keychain)"
    },
    "macos": {
      "level": "unsupported",
      "reason": "Owned-user macOS GUI login and Keychain isolation are not yet proven by a real logged-in desktop session."
    },
    "linux": {
      "level": "unsupported",
      "reason": "Owned-user Linux GUI and Secret Service sessions are not yet implemented and verified."
    }
  },
  "install": "https://antigravity.google.com/",
  "versionCommand": [
    "--version"
  ]
}
