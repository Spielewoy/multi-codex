{
  "schemaVersion": 2,
  "id": "claude-cli",
  "displayName": "Claude Code",
  "kind": "cli",
  "binary": {
    "windows": ["%APPDATA%\\npm\\claude.cmd", "%APPDATA%\\npm\\claude", "claude"],
    "macos": ["/usr/local/bin/claude", "$HOME/.npm-global/bin/claude", "claude"],
    "linux": ["$HOME/.npm-global/bin/claude", "claude"]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "foreground",
    "env": { "CLAUDE_CONFIG_DIR": "{runtimeRoot}" },
    "clearEnv": []
  },
  "account": {
    "mechanism": "fileOverlay",
    "credentialFiles": [".credentials.json"],
    "credentialPrecedence": [".credentials.json"],
    "logoutScope": "profile"
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.claude",
      "macos": "$HOME/.claude",
      "linux": "$HOME/.claude"
    },
    "sharedPaths": [
      "CLAUDE.md", "settings.json", "keybindings.json", "themes", "rules", "skills",
      "commands", "output-styles", "agents", "workflows", "agent-memory", "plugins",
      "file-history", "plans", "debug", "paste-cache", "image-cache", "session-env",
      "tasks", "shell-snapshots", "backups", "feedback-bundles", "stats-cache.json",
      "remote-settings.json"
    ],
    "sessionPaths": ["projects", "history.jsonl"],
    "filePaths": [
      "CLAUDE.md", "settings.json", "keybindings.json", "history.jsonl", "stats-cache.json",
      "remote-settings.json"
    ],
    "unsafePaths": []
  },
  "concurrency": { "level": "multiWriter", "singletonScope": "none" },
  "support": {
    "windows": { "level": "supported", "reason": "file overlay" },
    "macos": { "level": "supported", "reason": "API-key profiles use file overlay; subscription OAuth is unsupported because its fixed Keychain identity is not isolated" },
    "linux": { "level": "supported", "reason": "file overlay" }
  },
  "install": "npm i -g @anthropic-ai/claude-code",
  "versionCommand": ["--version"]
}
