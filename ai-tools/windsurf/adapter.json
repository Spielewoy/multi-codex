{
  "schemaVersion": 2,
  "id": "windsurf",
  "displayName": "Devin Desktop (Windsurf)",
  "kind": "ide",
  "binary": {
    "windows": ["devin-desktop", "surf", "windsurf", "%LOCALAPPDATA%\\Programs\\Devin\\bin\\devin-desktop.cmd"],
    "macos": ["devin-desktop", "surf", "windsurf"],
    "linux": ["devin-desktop", "surf", "windsurf"]
  },
  "isolation": { "strategy": "accountOverlay", "mode": "detached", "env": {}, "clearEnv": [] },
  "account": {
    "mechanism": "osUserCredentialStore",
    "credentialFiles": [],
    "credentialPrecedence": ["Devin account or manual API-key login"],
    "logoutScope": "osUser"
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.codeium\\windsurf",
      "macos": "$HOME/.codeium/windsurf",
      "linux": "$HOME/.codeium/windsurf"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": []
  },
  "concurrency": { "level": "singleWriter", "singletonScope": "unknown" },
  "support": {
    "windows": { "level": "supported", "reason": "OS-user isolation; elevated terminal required" },
    "macos": { "level": "supported", "reason": "OS-user isolation with sudo" },
    "linux": { "level": "supported", "reason": "OS-user isolation with sudo and acl" }
  },
  "install": "https://docs.devin.ai/desktop/getting-started",
  "versionCommand": ["--version"]
}
