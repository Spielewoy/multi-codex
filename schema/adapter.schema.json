{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-cli.local/schema/adapter.schema.json",
  "title": "multi-cli adapter",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "kind",
    "binary",
    "isolation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "default": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "cli",
        "ide",
        "gui",
        "hybrid"
      ]
    },
    "binary": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "env",
            "userDataDir",
            "redirectHome",
            "appdata",
            "sandboxUser",
            "accountOverlay"
          ]
        },
        "mode": {
          "enum": [
            "foreground",
            "detached"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clearEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shareFromRealHome": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "mechanism"
      ],
      "properties": {
        "mechanism": {
          "enum": [
            "processSecret",
            "fileOverlay",
            "osUserCredentialStore",
            "inseparable"
          ]
        },
        "credentialFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "credentialPrecedence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logoutScope": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "secret": {
          "type": "object",
          "required": [
            "environmentVariable"
          ],
          "properties": {
            "environmentVariable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "normalState": {
      "type": "object",
      "required": [
        "root",
        "sharedPaths",
        "sessionPaths",
        "unsafePaths"
      ],
      "properties": {
        "root": {
          "type": "object",
          "required": [
            "windows",
            "macos",
            "linux"
          ],
          "properties": {
            "windows": {
              "type": "string",
              "minLength": 1
            },
            "macos": {
              "type": "string",
              "minLength": 1
            },
            "linux": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "sharedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "sessionPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "filePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "unsafePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "required": [
        "level",
        "singletonScope"
      ],
      "properties": {
        "level": {
          "enum": [
            "multiWriter",
            "singleWriter",
            "unsupported"
          ]
        },
        "singletonScope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "windows",
        "macos",
        "linux"
      ],
      "properties": {
        "windows": {
          "$ref": "#/$defs/support"
        },
        "macos": {
          "$ref": "#/$defs/support"
        },
        "linux": {
          "$ref": "#/$defs/support"
        }
      },
      "additionalProperties": false
    },
    "appx": {
      "type": "object",
      "required": [
        "packageName",
        "applicationId"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "storeProductId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "versionCommand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "share": {
      "$ref": "#/$defs/legacyShare"
    },
    "session": {
      "$ref": "#/$defs/legacySession"
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "legacyShare": {
      "type": "object",
      "properties": {
        "systemHome": {
          "type": "string",
          "minLength": 1
        },
        "linkable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "neverLink": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "legacySession": {
      "type": "object",
      "properties": {
        "portable": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "resumeHint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^[/\\\\]"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
          }
        ]
      }
    },
    "support": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "supported",
            "experimental",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "account",
          "normalState",
          "concurrency",
          "support"
        ],
        "properties": {
          "isolation": {
            "required": [
              "strategy",
              "mode"
            ],
            "properties": {
              "strategy": {
                "const": "accountOverlay"
              },
              "shareFromRealHome": false
            }
          },
          "share": false,
          "session": false,
          "status": false
        }
      },
      "else": {
        "properties": {
          "account": false,
          "normalState": false,
          "concurrency": false,
          "support": false,
          "appx": false
        }
      }
    }
  ]
}
