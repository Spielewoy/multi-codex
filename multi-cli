format_bytes() {
  local bytes="$1"
  if [ "$bytes" -ge 1073741824 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f GB\", $bytes/1073741824}"
  elif [ "$bytes" -ge 1048576 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f MB\", $bytes/1048576}"
  elif [ "$bytes" -ge 1024 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f KB\", $bytes/1024}"
  else
    echo "$bytes B"
  fi
}

# Human-readable size of a directory tree; "0 B" for anything missing.
folder_size() {
  local p="$1"
  [ -d "$p" ] || { echo "0 B"; return; }
  local bytes
  if [ "$(platform)" = "macos" ]; then
    bytes="$(du -sk "$p" 2>/dev/null | awk '{print $1 * 1024}')" || bytes=0
  else
    bytes="$(du -sb "$p" 2>/dev/null | awk '{print $1}')" || bytes=0
  fi
  format_bytes "$bytes"
}

cmd_list() {
  local tool_filter="${1:-}"
  [ -d "$BASE" ] || { echo "No profiles yet."; return; }

  local tool_dir
  for tool_dir in "$BASE"/*/; do
    [ -d "$tool_dir" ] || continue
    local tname="$(basename "$tool_dir")"
    [[ "$tname" == .* ]] && continue
    [ "$tname" = "bin" ] && continue
    [ -n "$tool_filter" ] && [ "$tname" != "$tool_filter" ] && continue

    echo ""
    printf '\033[36m[%s]\033[0m\n' "$tname"
    local pdir found=false
    for pdir in "$tool_dir"*/; do
      [ -d "$pdir" ] || continue
      found=true
      local pname="$(basename "$pdir")"
      local ptype="full"
      [ -f "$pdir/.cli" ] && ptype="cli"
      [ -f "$pdir/.shared" ] && ptype="shared"
      [ -f "$pdir/.isolated" ] && ptype="isolated"
      printf "  %-20s %-8s %s\n" "$pname" "$ptype" "$(folder_size "$pdir")"
    done
    [ "$found" = false ] && echo "  (none)"
  done
  return 0
}

cmd_tools() {
  echo "Supported tools:"
  echo ""
  printf "  %-18s %-12s %-15s %-10s %s\n" "TOOL" "KIND" "STRATEGY" "STATUS" "INSTALLED"
  printf "  %-18s %-12s %-15s %-10s %s\n" "----" "----" "--------" "------" "---------"

  local tid
  for tid in $(list_tool_ids | sort); do
    local apath="$(adapter_path "$tid")"
    local kind strategy status reason installed color
    kind="$(json_str '.kind' "$apath")"
    strategy="$(json_str '.isolation.strategy' "$apath")"
    status="$(json_str ".support.$(platform).level" "$apath")"
    reason="$(json_str ".support.$(platform).reason" "$apath")"
    [ -z "$status" ] && status="$(json_str '.status' "$apath")"
    [ -z "$status" ] && status="?"
    if find_adapter_binary "$tid" >/dev/null 2>&1; then
      installed="yes"; color="\033[32m"
    else
      installed="no"; color="\033[90m"
    fi
    printf "  ${color}%-18s %-12s %-15s %-10s %s\033[0m\n" "$tid" "$kind" "$strategy" "$status" "$installed"
    [ -n "$reason" ] && printf '    %s\n' "$reason"
  done
}

cmd_doctor() {
  local deep="${1:-}"
  local errors=0 warnings=0
  echo "multi-cli $VERSION  --  $(platform)"
  echo ""
  echo "Profile storage: $BASE"

  if [ -d "$BASE" ]; then
    if touch "$BASE/.write-test" 2>/dev/null; then
      rm -f "$BASE/.write-test"
      printf '  \033[32m[OK] writable\033[0m\n'
    else
      printf '  \033[31m[FAIL] not writable\033[0m\n'
      errors=$((errors + 1))
    fi
  else
    echo "  [INFO] not yet created (will be created on first profile)"
  fi

  if alias_dir_in_path; then
    printf 'Alias dir in PATH: \033[32myes\033[0m\n'
  else
    printf 'Alias dir in PATH: \033[33mno\033[0m  (%s -- add to PATH for shorthand commands)\n' "$(alias_dir)"
    warnings=$((warnings + 1))
  fi

  echo ""
  echo "Tools:"
  local tid
  for tid in $(list_tool_ids | sort); do
    local bin
    if bin="$(find_adapter_binary "$tid")"; then
      printf '  \033[32m[OK]   %s -> %s\033[0m\n' "$tid" "$bin"
    else
      local hint
      hint="$(json_str '.install' "$(adapter_path "$tid")")"
      [ -n "$hint" ] && hint="  install: $hint"
      printf '  \033[90m[MISS] %s%s\033[0m\n' "$tid" "$hint"
    fi
    local support_level support_reason
    support_level="$(json_str ".support.$(platform).level" "$(adapter_path "$tid")")"
    support_reason="$(json_str ".support.$(platform).reason" "$(adapter_path "$tid")")"
    if [ -n "$support_reason" ]; then
      if [ "$support_level" = unsupported ]; then
        printf '         \033[33m%s: %s\033[0m\n' "$support_level" "$support_reason"
      else
        printf '         %s: %s\n' "$support_level" "$support_reason"
      fi
    fi
  done

  if [ "$deep" = "--deep" ]; then
    echo ""
    echo "Runtime audit (schema-v2 profiles):"
    local profile_json pdir runtime rel f
    if [ -d "$BASE" ]; then
      for profile_json in "$BASE"/*/*/.profile.json; do
        [ -f "$profile_json" ] || continue
        pdir="$(dirname "$profile_json")"
        runtime="$pdir/.runtime"
        [ -d "$runtime" ] || continue
        if [ ! -f "$runtime/.runtime-manifest" ]; then
          printf '  \033[33m[WARN] %s runtime has no manifest (built before audit support)\033[0m\n' "$pdir"
          warnings=$((warnings + 1))
          continue
        fi
        local apath expected item target expected_target
        apath="$(adapter_path "$(basename "$(dirname "$pdir")")")"
        while IFS= read -r rel; do
          [ -n "$rel" ] || continue
          item="$runtime/$rel"
          if [ ! -e "$item" ] && [ ! -L "$item" ]; then
            printf '  \033[33m[WARN] missing declared runtime path %s in %s -- relaunch the profile\033[0m\n' "$rel" "$pdir"
            warnings=$((warnings + 1))
            continue
          fi
          if [ -L "$item" ]; then
            target="$(cd "$(dirname "$item")" && cd "$(dirname "$(readlink "$item")")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$(readlink "$item")")" || true)"
            expected_target=""
            if runtime_json_arr '.account.credentialFiles' "$apath" | grep -qxF "$rel"; then
              expected_target="$pdir/auth/$rel"
            else
              expected_target="$(runtime_platform_root "$apath")/$rel"
            fi
            expected_target="$(cd "$(dirname "$expected_target")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$expected_target")" || true)"
            if [ -z "$target" ] || [ "$target" != "$expected_target" ]; then
              printf '  \033[33m[WARN] runtime path %s in %s points to the wrong target\033[0m\n' "$rel" "$pdir"
              warnings=$((warnings + 1))
            fi
          fi
        done < "$runtime/.runtime-manifest"
        while IFS= read -r f; do
          rel="${f#"$runtime"/}"
          [ "$rel" = ".runtime-manifest" ] && continue
          if ! grep -qxF "$rel" "$runtime/.runtime-manifest"; then
            printf '  \033[33m[WARN] unexpected runtime file %s in %s -- adapter classification defect\033[0m\n' "$rel" "$pdir"
            warnings=$((warnings + 1))
          fi
        done < <(find "$runtime" -type f 2>/dev/null)
      done
    fi
  fi

  echo ""
  if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
    printf '\033[32mAll good.\033[0m\n'
    return 0
  elif [ $errors -eq 0 ]; then
    printf '\033[33m%d warning(s).\033[0m\n' "$warnings"
    [ "$deep" = --deep ] && return 1
    return 0
  else
    printf '\033[31m%d error(s), %d warning(s).\033[0m\n' "$errors" "$warnings"
  fi
  return 1
}

cmd_stats() {
  [ -d "$BASE" ] || { echo "No profiles yet."; return; }
  printf "%-30s %s\n" "PROFILE" "SIZE"
  local td
  for td in "$BASE"/*/; do
    [ -d "$td" ] || continue
    local tname="$(basename "$td")"
    [[ "$tname" == .* ]] && continue
    [ "$tname" = "bin" ] && continue
    local pd
    for pd in "$td"*/; do
      [ -d "$pd" ] || continue
      printf "%-30s %s\n" "$tname/$(basename "$pd")" "$(folder_size "$pd")"
    done
  done
  echo ""
  echo "Total: $(folder_size "$BASE")"
}

