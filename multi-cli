# =============================================================================
# Main dispatch
# =============================================================================

need_jq

cmd="${1:-}"
shift || true

case "$cmd" in
  new)        cmd_new "$@" ;;
  auth)       cmd_auth "$@" ;;
  launch)
    spec="${1:-}"; shift || true
    launch_args=()
    saw_delim=false
    for a in "$@"; do
      if [ "$saw_delim" = false ] && [ "$a" = "--" ]; then saw_delim=true; continue; fi
      launch_args+=("$a")
    done
    cmd_launch "$spec" "${launch_args[@]+"${launch_args[@]}"}"
    ;;
  list)       cmd_list "${1:-}" ;;
  status)     cmd_list "${1:-}" ;;
  rename)     cmd_rename "${1:-}" "${2:-}" ;;
  delete)     cmd_delete "${1:-}" ;;
  clone)      cmd_clone "${1:-}" "${2:-}" ;;
  migrate)    cmd_migrate "$@" ;;
  continue)   cmd_continue "$@" ;;
  template)   cmd_template "$@" ;;
  export)     cmd_export "$@" ;;
  import)     cmd_import "$@" ;;
  tools)      cmd_tools ;;
  doctor)     cmd_doctor "${1:-}" ;;
  stats)      cmd_stats ;;
  completion) cmd_completion "${1:-bash}" ;;
  help|--help|-h) cmd_help ;;
  version|--version|-v) echo "multi-cli $VERSION" ;;
  "")         cmd_help; exit 1 ;;
  *)
    if [[ "$cmd" == */* ]]; then
      cmd_launch "$cmd" "$@"
    else
      echo "Unknown command: $cmd"
      cmd_help
      exit 1
    fi
    ;;
esac
